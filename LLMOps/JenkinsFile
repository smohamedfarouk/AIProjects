pipeline {
    agent any

    options {
        skipDefaultCheckout()
    }

     environment {
        SONAR_PROJECT_KEY = "LLMOps"
        SONAR_SCANNER_HOME = tool 'sonarqube-scanner'
    //     AWS_REGION = "eu-west-1"
    //     ECR_REPOSITORY = "llmops"sonarqube-custom 
    //     IMAGE_NAME = "llmops"
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/smohamedfarouk/AIProjects.git',
                    credentialsId: 'github-credentials'
            
            }
        }

        stage('Verify LLMOps') {
            steps {
                dir('LLMOps') {
                    sh 'test -f requirement.txt && test -f app/main.py'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('LLMOps') {
                    withCredentials([string(credentialsId: 'Sonarqube', variable: 'SONAR_TOKEN')]) {
                        withSonarQubeEnv('sonar-env') {
                            sh '"$SONAR_SCANNER_HOME/bin/sonar-scanner" -Dsonar.projectKey="$SONAR_PROJECT_KEY" -Dsonar.host.url="$SONAR_HOST_URL"'
                        }
                    }
                }
            }
        }
        // stage('Build Docker Image') {
        //     steps {
        //         script {
        //             def imageTag = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_NAME}"
        //             sh "docker build -t ${imageTag} ."
        //         }
        //     }
        // }

        // stage('Push Docker Image to ECR') {
        //     steps {
        //         script {
        //             def imageTag = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}:${IMAGE_NAME}"
        //             sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        //             sh "docker push ${imageTag}"
        //         }
        //     }
        // }
    }


   
}