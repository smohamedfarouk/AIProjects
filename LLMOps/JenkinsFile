pipeline {
    agent any

    options {
        skipDefaultCheckout()
    }

    environment {
        SONAR_PROJECT_KEY = "LLMOps"
        SONAR_SCANNER_HOME = tool 'sonarqube-scanner'
        AWS_REGION = "eu-west-2"
        ECR_REPOSITORY = "llmops-ecr"
        IMAGE_NAME = "latest"
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/smohamedfarouk/AIProjects.git',
                    credentialsId: 'github-credentials'
            
            }
        }

        stage('Verify LLMOps') {
            steps {
                dir('LLMOps') {
                    sh 'test -f requirement.txt && test -f app/main.py'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('LLMOps') {
                    withSonarQubeEnv('sonar-env') {
                        sh '"$SONAR_SCANNER_HOME/bin/sonar-scanner" -Dsonar.projectKey="$SONAR_PROJECT_KEY" -Dsonar.host.url="$SONAR_HOST_URL"'
                    }
                }
            }
        }
        stage('Build Docker Image') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'llmops-aws-credentials']]) {
                    script {
                        def AWS_ACCOUNT_ID = sh(script: "aws sts get-caller-identity --query Account --output text", returnStdout: true).trim()
                        def ECR_REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}"
                        echo "ECR Repository URI: ${ECR_REPOSITORY_URI}"
                        sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                        dir('LLMOps') {
                            sh "docker build -f DockerFile -t ${ECR_REPOSITORY_URI}:${IMAGE_NAME} ."
                        }
                        sh "docker tag ${ECR_REPOSITORY_URI}:${IMAGE_NAME} ${ECR_REPOSITORY_URI}:${IMAGE_NAME}"
                        sh "docker push ${ECR_REPOSITORY_URI}:${IMAGE_NAME}"
                    }
                }
            }
        }
        stage('Deploy to Fargate') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'llmops-aws-credentials']]) {
                    echo "Deploying to Fargate..."
                    script {
                        sh "echo Deploying to Fargate..."
                        sh "aws ecs update-service --cluster llmops-cluster --service llmops-task-definition-service-7gb2j3hw --force-new-deployment"
                        sh "aws ecs wait services-stable --cluster llmops-cluster --services llmops-task-definition-service-7gb2j3hw"
                        // Add your Fargate deployment commands here
                    }
                }
            }
        }
    }
}